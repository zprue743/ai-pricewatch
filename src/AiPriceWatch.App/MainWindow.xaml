<Window x:Class="AiPriceWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI PriceWatch HUD"
        Width="860"
        Height="510"
        MinWidth="660"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsAlwaysOnTop}"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Cascadia Mono, Consolas, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="10"
            BorderBrush="#4458A6FF"
            BorderThickness="1.2"
            Margin="6">
        <Border.Background>
            <SolidColorBrush x:Name="HudBackgroundBrush" Color="#DD0D1117" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Title Bar & HUD Controls -->
                <RowDefinition Height="38" />
                <!-- Row 1: Provider Selector Tabs & Search/Sort -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Column Headers -->
                <RowDefinition Height="28" />
                <!-- Row 3: Scrollable Model Pricing Rows -->
                <RowDefinition Height="*" />
                <!-- Row 4: Task Cost Estimator & Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Frameless Drag Header -->
            <Border Grid.Row="0"
                    Background="#33161B22"
                    BorderBrush="#2630363D"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#3FB950" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="AI PRICEWATCH"
                                   Foreground="#E6EDF3"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" // HUD OVERLAY"
                                   Foreground="#7D8590"
                                   FontSize="11"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="OPACITY"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <Slider x:Name="OpacitySlider"
                                Width="70"
                                Minimum="0.35"
                                Maximum="1.0"
                                Value="{Binding BackgroundOpacity, Mode=TwoWay}"
                                ValueChanged="OpacitySlider_ValueChanged"
                                VerticalAlignment="Center"
                                ToolTip="Adjust HUD background translucency (keeps text crisp)" />
                        <TextBlock Text="{Binding OpacityPercentageDisplay}"
                                   Foreground="#58A6FF"
                                   FontSize="10"
                                   Width="32"
                                   Margin="5,0,8,0"
                                   VerticalAlignment="Center" />

                        <Button x:Name="FastModeButton"
                                Content="⚡ FAST: OFF"
                                Click="FastModeButton_Click"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#8B949E"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                ToolTip="Toggle Fast / Priority Mode pricing for task cost estimates (Ctrl+M)" />

                        <Button x:Name="PinButton"
                                Content="PIN: ON"
                                Click="PinButton_Click"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#58A6FF"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                ToolTip="Toggle Always-on-Top window pin" />

                        <Button x:Name="SyncButton"
                                Content="SYNC LIVE"
                                Click="SyncButton_Click"
                                Padding="7,2"
                                Margin="0,0,8,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#3FB950"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                ToolTip="Fetch live model token prices from OpenRouter" />

                        <Button Content="—"
                                Click="MinimizeButton_Click"
                                Width="24"
                                Height="22"
                                Margin="0,0,4,0"
                                FontSize="11"
                                Foreground="#8B949E"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                ToolTip="Minimize HUD (or press Ctrl+Shift+Space to toggle)" />

                        <Button Content="✕"
                                Click="CloseButton_Click"
                                Width="24"
                                Height="22"
                                FontSize="11"
                                Foreground="#F85149"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                ToolTip="Close AI PriceWatch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Provider Tabs + Search & Tier / Sort Filter -->
            <Border Grid.Row="1"
                    Padding="10,8,10,8"
                    BorderBrush="#2630363D"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Provider Selector Buttons -->
                    <WrapPanel x:Name="ProviderTabsPanel"
                               Grid.Row="0"
                               Orientation="Horizontal"
                               Margin="0,0,0,6" />

                    <!-- Search Box, Tier Filter & Sort Selector -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#161B22"
                                     Foreground="#E6EDF3"
                                     CaretBrush="#58A6FF"
                                     BorderBrush="#30363D"
                                     BorderThickness="1"
                                     Padding="7,3"
                                     FontSize="11.5"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Filter models by name, ID, provider, or use case (Ctrl+F)" />
                            <TextBlock Text="Search models (e.g. composer, grok 4.6, argon, sonnet)... [Ctrl+F]"
                                       Foreground="#6E7681"
                                       FontSize="11"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox x:Name="TierComboBox"
                                  Grid.Column="1"
                                  Width="135"
                                  Margin="0,0,8,0"
                                  FontSize="11"
                                  SelectionChanged="TierComboBox_SelectionChanged"
                                  SelectedIndex="0"
                                  ToolTip="Filter by model task tier">
                            <ComboBoxItem Content="Tier: All" Tag="All" />
                            <ComboBoxItem Content="Tier: Budget / Fast" Tag="Fast" />
                            <ComboBoxItem Content="Tier: Balanced" Tag="Balanced" />
                            <ComboBoxItem Content="Tier: Reasoning" Tag="Reasoning" />
                        </ComboBox>

                        <ComboBox x:Name="SortComboBox"
                                  Grid.Column="2"
                                  Width="176"
                                  FontSize="11"
                                  SelectionChanged="SortComboBox_SelectionChanged"
                                  SelectedIndex="0"
                                  ToolTip="Sort models">
                            <ComboBoxItem Content="Sort: Flagships First" Tag="Featured" />
                            <ComboBoxItem Content="Sort: Score (AAII) ↓" Tag="ScoreDesc" />
                            <ComboBoxItem Content="Sort: Input $/1M ↑" Tag="InputPriceAsc" />
                            <ComboBoxItem Content="Sort: Output $/1M ↑" Tag="OutputPriceAsc" />
                            <ComboBoxItem Content="Sort: Est. Task Cost ↑" Tag="TotalTaskCostAsc" />
                            <ComboBoxItem Content="Sort: Context Size ↓" Tag="ContextDesc" />
                            <ComboBoxItem Content="Sort: Model Name A-Z" Tag="NameAsc" />
                        </ComboBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: Table Column Headers -->
            <Border Grid.Row="2"
                    Background="#22161B22"
                    BorderBrush="#3330363D"
                    BorderThickness="0,0,0,1"
                    Padding="12,0,18,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*" />
                        <ColumnDefinition Width="0.72*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.72*" />
                        <ColumnDefinition Width="0.55*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MODEL / PROVIDER • TIER" Foreground="#8B949E" FontSize="10" FontWeight="Bold" />
                    <TextBlock Grid.Column="1"
                               Text="AAII SCORE"
                               Foreground="#D2A8FF"
                               FontSize="10"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               ToolTip="Artificial Analysis Intelligence Index v5 composite benchmark score" />
                    <TextBlock Grid.Column="2"
                               Text="STD (IN / OUT)"
                               Foreground="#E6EDF3"
                               FontSize="10"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               ToolTip="Standard Mode: Input $ / Output $ per 1M tokens" />
                    <TextBlock Grid.Column="3"
                               Text="⚡ FAST (IN / OUT)"
                               Foreground="#FFA657"
                               FontSize="10"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               ToolTip="Fast / Priority Mode: Input $ / Output $ per 1M tokens" />
                    <TextBlock Grid.Column="4" Text="CACHE /1M" Foreground="#79C0FF" FontSize="10" FontWeight="Bold" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="CTX" Foreground="#8B949E" FontSize="10" FontWeight="Bold" TextAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="EST. TASK" Foreground="#3FB950" FontSize="10" FontWeight="Bold" TextAlignment="Right" />
                </Grid>
            </Border>

            <!-- Row 3: Scrollable Model Pricing List -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="6,4,6,4">
                <ItemsControl ItemsSource="{Binding VisibleModels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,2,2,2"
                                    Padding="8,6,10,6"
                                    CornerRadius="5"
                                    Background="#181F242C"
                                    BorderBrush="#2230363D"
                                    BorderThickness="1"
                                    ToolTip="{Binding Notes}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.15*" />
                                        <ColumnDefinition Width="0.72*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="0.72*" />
                                        <ColumnDefinition Width="0.55*" />
                                        <ColumnDefinition Width="0.95*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Model Name, Provider & Tier -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#F0F6FC"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <Border Background="#1F3FB950"
                                                    BorderBrush="#3FB950"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsCheapestInView, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="BEST VALUE"
                                                           Foreground="#3FB950"
                                                           FontSize="8.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding Provider}"
                                                       Foreground="#7D8590"
                                                       FontSize="10" />
                                            <TextBlock Text=" • "
                                                       Foreground="#484F58"
                                                       FontSize="10" />
                                            <TextBlock Text="{Binding TierBadge}"
                                                       Foreground="#8B949E"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Published Credible Score (Artificial Analysis Intelligence Index) -->
                                    <Border Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Background="#1FD2A8FF"
                                            BorderBrush="#55D2A8FF"
                                            BorderThickness="1"
                                            ToolTip="Artificial Analysis Intelligence Index v5 Score">
                                        <TextBlock Text="{Binding ScoreDisplay}"
                                                   Foreground="#D2A8FF"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <!-- Standard Mode Input / Output $/1M -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StandardInOutDisplay}"
                                               Foreground="#E6EDF3"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Fast / Priority Mode Input / Output $/1M -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding FastInOutDisplay}"
                                               Foreground="#FFA657"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Cached Input $/1M -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding CachedPriceDisplay}"
                                               Foreground="#79C0FF"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Context Window -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding ContextDisplay}"
                                               Foreground="#8B949E"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Estimated Task Cost -->
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding EstimatedTaskCostDisplay}"
                                               Foreground="#3FB950"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Row 4: Interactive Task Cost Estimator & Status Bar -->
            <Border Grid.Row="4"
                    Background="#33161B22"
                    BorderBrush="#2630363D"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="12,7,14,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="WORKLOAD:"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="PresetComboBox"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="148"
                                  FontSize="11"
                                  Margin="0,0,10,0"
                                  ToolTip="Select a typical task token workload to compare model costs" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="IN:" Foreground="#8B949E" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="56"
                                 Text="{Binding TaskInputTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#161B22"
                                 Foreground="#E6EDF3"
                                 BorderBrush="#30363D"
                                 FontSize="11"
                                 Padding="4,1"
                                 Margin="0,0,8,0" />

                        <TextBlock Text="CACHE:" Foreground="#79C0FF" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="56"
                                 Text="{Binding TaskCachedTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#161B22"
                                 Foreground="#79C0FF"
                                 BorderBrush="#30363D"
                                 FontSize="11"
                                 Padding="4,1"
                                 Margin="0,0,8,0" />

                        <TextBlock Text="OUT:" Foreground="#FFA657" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="52"
                                 Text="{Binding TaskOutputTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#161B22"
                                 Foreground="#FFA657"
                                 BorderBrush="#30363D"
                                 FontSize="11"
                                 Padding="4,1" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText}"
                               Foreground="#7D8590"
                               FontSize="10"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
