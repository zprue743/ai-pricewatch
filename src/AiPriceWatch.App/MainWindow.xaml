<Window x:Class="AiPriceWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI PriceWatch HUD"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Width="960"
        Height="520"
        MinWidth="750"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="{Binding IsAlwaysOnTop}"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Cascadia Mono, Consolas, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="10"
            BorderBrush="#4458A6FF"
            BorderThickness="1.2"
            Margin="6">
        <Border.Background>
            <SolidColorBrush x:Name="HudBackgroundBrush" Color="#DD0D1117" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Title Bar & HUD Controls -->
                <RowDefinition Height="38" />
                <!-- Row 1: Provider Selector Tabs & Search/Sort -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Column Headers -->
                <RowDefinition Height="28" />
                <!-- Row 3: Scrollable Model Pricing Rows -->
                <RowDefinition Height="*" />
                <!-- Row 4: Task Cost Estimator & Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Frameless Drag Header -->
            <Border Grid.Row="0"
                    Background="#33161B22"
                    BorderBrush="#2630363D"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/app-icon.ico"
                               Width="18"
                               Height="18"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="AI PRICEWATCH"
                                   Foreground="#E6EDF3"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" // HUD OVERLAY"
                                   Foreground="#7D8590"
                                   FontSize="11"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="OPACITY"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <Slider x:Name="OpacitySlider"
                                Width="70"
                                Minimum="0.35"
                                Maximum="1.0"
                                Value="{Binding BackgroundOpacity, Mode=TwoWay}"
                                ValueChanged="OpacitySlider_ValueChanged"
                                VerticalAlignment="Center"
                                ToolTip="Adjust HUD background translucency (keeps text crisp)" />
                        <TextBlock Text="{Binding OpacityPercentageDisplay}"
                                   Foreground="#58A6FF"
                                   FontSize="10"
                                   Width="32"
                                   Margin="5,0,8,0"
                                   VerticalAlignment="Center" />

                        <Button x:Name="FastModeButton"
                                Content="⚡ FAST: OFF"
                                Click="FastModeButton_Click"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#8B949E"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Toggle Fast or Priority Mode"
                                ToolTip="Toggle Fast / Priority Mode pricing for task cost estimates (Ctrl+M)" />

                        <Button x:Name="PinButton"
                                Content="PIN: ON"
                                Click="PinButton_Click"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#58A6FF"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Toggle Always on Top"
                                ToolTip="Toggle Always-on-Top window pin" />

                        <Button x:Name="AddModelsButton"
                                Click="AddModelsButton_Click"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#58A6FF"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Browse and add OpenRouter models"
                                ToolTip="Browse and add models from the OpenRouter live feed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+ ADD" VerticalAlignment="Center" />
                                <Border Background="#223FB950"
                                        BorderBrush="#3FB950"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="4,0"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasNewOpenRouterModels, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Foreground="#3FB950" FontSize="8.5" FontWeight="Bold">
                                        <Run Text="{Binding NewOpenRouterCount, Mode=OneWay}" />
                                        <Run Text=" NEW" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="SyncButton"
                                Content="SYNC LIVE"
                                Click="SyncButton_Click"
                                Padding="7,2"
                                Margin="0,0,6,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#3FB950"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Sync live prices from OpenRouter and CursorBench scores"
                                ToolTip="Fetch live model token prices from OpenRouter and CursorBench scores from cursor.com" />

                        <Button x:Name="SettingsButton"
                                Content="⚙"
                                Click="SettingsButton_Click"
                                Width="26"
                                Height="22"
                                Margin="0,0,6,0"
                                FontSize="11"
                                Foreground="#8B949E"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Open Settings and Help"
                                ToolTip="Settings, Startup, &amp; Quick Guide" />

                        <Button x:Name="UpdateButton"
                                Content="UPDATE"
                                Click="UpdateButton_Click"
                                Visibility="Collapsed"
                                Padding="7,2"
                                Margin="0,0,8,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#F0883E"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Install application update"
                                ToolTip="Download and install the latest version" />

                        <Button Content="—"
                                Click="MinimizeButton_Click"
                                Width="24"
                                Height="22"
                                Margin="0,0,4,0"
                                FontSize="11"
                                Foreground="#8B949E"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                AutomationProperties.Name="Minimize HUD"
                                ToolTip="Minimize HUD (or press Ctrl+Shift+Space to toggle)" />

                        <Button Content="✕"
                                Click="CloseButton_Click"
                                Width="24"
                                Height="22"
                                FontSize="11"
                                Foreground="#F85149"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Cursor="Hand"
                                AutomationProperties.Name="Hide HUD to system tray"
                                ToolTip="Hide to system tray (Ctrl+Shift+Space or tray icon to reopen)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Provider Tabs + Search & Tier / Sort / Hidden Filter -->
            <Border Grid.Row="1"
                    Padding="10,8,10,8"
                    BorderBrush="#2630363D"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Provider Selector Buttons -->
                    <WrapPanel x:Name="ProviderTabsPanel"
                               Grid.Row="0"
                               Orientation="Horizontal"
                               Margin="0,0,0,6" />

                    <!-- Search Box, Tier Filter, Sort Selector & Hidden Controls -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#161B22"
                                     Foreground="#E6EDF3"
                                     CaretBrush="#58A6FF"
                                     BorderBrush="#30363D"
                                     BorderThickness="1"
                                     Padding="7,3"
                                     FontSize="11.5"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Filter models by name, ID, provider, or use case (Ctrl+F)" />
                            <TextBlock Text="Search models (e.g. composer, grok 4.6, argon, sonnet)... [Ctrl+F]"
                                       Foreground="#6E7681"
                                       FontSize="11"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox x:Name="TierComboBox"
                                  Grid.Column="1"
                                  Width="132"
                                  Margin="0,0,6,0"
                                  FontSize="11"
                                  SelectionChanged="TierComboBox_SelectionChanged"
                                  SelectedIndex="0"
                                  ToolTip="Filter by model task tier">
                            <ComboBoxItem Content="Tier: All" Tag="All" />
                            <ComboBoxItem Content="Tier: Budget / Fast" Tag="Fast" />
                            <ComboBoxItem Content="Tier: Balanced" Tag="Balanced" />
                            <ComboBoxItem Content="Tier: Reasoning" Tag="Reasoning" />
                        </ComboBox>

                        <ComboBox x:Name="SortComboBox"
                                  Grid.Column="2"
                                  Width="168"
                                  Margin="0,0,6,0"
                                  FontSize="11"
                                  SelectionChanged="SortComboBox_SelectionChanged"
                                  SelectedIndex="0"
                                  ToolTip="Sort models">
                            <ComboBoxItem Content="Sort: Score (AAII) ↓" Tag="ScoreDesc" />
                            <ComboBoxItem Content="Sort: CursorBench ↓" Tag="CursorBenchDesc" />
                            <ComboBoxItem Content="Sort: Flagships First" Tag="Featured" />
                            <ComboBoxItem Content="Sort: Input $/1M ↑" Tag="InputPriceAsc" />
                            <ComboBoxItem Content="Sort: Output $/1M ↑" Tag="OutputPriceAsc" />
                            <ComboBoxItem Content="Sort: Est. Task Cost ↑" Tag="TotalTaskCostAsc" />
                            <ComboBoxItem Content="Sort: Context Size ↓" Tag="ContextDesc" />
                            <ComboBoxItem Content="Sort: Model Name A-Z" Tag="NameAsc" />
                        </ComboBox>

                        <Button x:Name="ToggleShowHiddenButton"
                                Grid.Column="3"
                                Content="{Binding HiddenToggleLabel}"
                                Click="ToggleShowHiddenButton_Click"
                                Padding="8,3"
                                Margin="0,0,4,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#8B949E"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                ToolTip="Show or hide models you have marked as hidden" />

                        <Button x:Name="UnhideAllButton"
                                Grid.Column="4"
                                Content="UNHIDE ALL"
                                Click="UnhideAllButton_Click"
                                Padding="7,3"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#58A6FF"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                Visibility="{Binding HasHiddenModels, Converter={StaticResource BoolToVis}}"
                                ToolTip="Restore all hidden models back to the HUD" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: Table Column Headers -->
            <Border Grid.Row="2"
                    Background="#22161B22"
                    BorderBrush="#3330363D"
                    BorderThickness="0,0,0,1"
                    Padding="12,0,18,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.0*" />
                        <ColumnDefinition Width="0.68*" />
                        <ColumnDefinition Width="0.76*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="0.68*" />
                        <ColumnDefinition Width="0.50*" />
                        <ColumnDefinition Width="0.88*" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MODEL / PROVIDER • TIER" Foreground="#8B949E" FontSize="10" FontWeight="Bold" />
                    <TextBlock Grid.Column="1"
                               Text="AAII"
                               Foreground="#D2A8FF"
                               FontSize="10"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               ToolTip="Artificial Analysis Intelligence Index v5 composite benchmark score" />
                    <TextBlock Grid.Column="2"
                               Text="CURSORBENCH"
                               Foreground="#56D4DD"
                               FontSize="10"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               ToolTip="CursorBench 4.0 peak correctness % (https://cursor.com/cursorbench)" />
                    <TextBlock Grid.Column="3"
                               Text="STD (IN / OUT)"
                               Foreground="#E6EDF3"
                               FontSize="10"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               ToolTip="Standard Mode: Input $ / Output $ per 1M tokens" />
                    <TextBlock Grid.Column="4"
                               Text="⚡ FAST (IN / OUT)"
                               Foreground="#FFA657"
                               FontSize="10"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               ToolTip="Fast / Priority Mode: Input $ / Output $ per 1M tokens" />
                    <TextBlock Grid.Column="5" Text="CACHE /1M" Foreground="#79C0FF" FontSize="10" FontWeight="Bold" TextAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="CTX" Foreground="#8B949E" FontSize="10" FontWeight="Bold" TextAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="EST. TASK" Foreground="#3FB950" FontSize="10" FontWeight="Bold" TextAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="VIEW" Foreground="#8B949E" FontSize="10" FontWeight="Bold" TextAlignment="Right" />
                </Grid>
            </Border>

            <!-- Row 3: Scrollable Model Pricing List -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="6,4,6,4">
                <ItemsControl ItemsSource="{Binding VisibleModels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,2,2,2"
                                    Padding="8,6,10,6"
                                    CornerRadius="5"
                                    Background="#181F242C"
                                    BorderBrush="#2230363D"
                                    BorderThickness="1"
                                    Opacity="{Binding RowOpacity}"
                                    ToolTip="{Binding RowDetailsTooltip}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.0*" />
                                        <ColumnDefinition Width="0.68*" />
                                        <ColumnDefinition Width="0.76*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="0.68*" />
                                        <ColumnDefinition Width="0.50*" />
                                        <ColumnDefinition Width="0.88*" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Model Name, Provider & Tier -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="#F0F6FC"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <Border Background="#1F3FB950"
                                                    BorderBrush="#3FB950"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Lowest estimated task cost among visible models with verified pricing for the current mode and token assumptions."
                                                    Visibility="{Binding IsCheapestInView, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="LOWEST EST. COST"
                                                           Foreground="#3FB950"
                                                           FontSize="8.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <Border Background="#22F85149"
                                                    BorderBrush="#F85149"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="HIDDEN"
                                                           Foreground="#F85149"
                                                           FontSize="8.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <Border Background="#223FB950"
                                                    BorderBrush="#3FB950"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding PriceDiffTooltip}"
                                                    Visibility="{Binding IsPriceDrop, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding PriceDiffBadge}"
                                                           Foreground="#3FB950"
                                                           FontSize="8.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <Border Background="#22D29922"
                                                    BorderBrush="#D29922"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding PriceDiffTooltip}"
                                                    Visibility="{Binding IsPriceIncrease, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding PriceDiffBadge}"
                                                           Foreground="#D29922"
                                                           FontSize="8.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding Provider}"
                                                       Foreground="#7D8590"
                                                       FontSize="10" />
                                            <TextBlock Text=" • "
                                                       Foreground="#484F58"
                                                       FontSize="10" />
                                            <TextBlock Text="{Binding TierBadge}"
                                                       Foreground="#8B949E"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text=" • "
                                                       Foreground="#484F58"
                                                       FontSize="10" />
                                            <TextBlock Text="{Binding PricingSourceBadge}"
                                                       Foreground="#6E7681"
                                                       FontSize="9.5" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Published Credible Score (Artificial Analysis Intelligence Index) -->
                                    <Border Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Background="#1FD2A8FF"
                                            BorderBrush="#55D2A8FF"
                                            BorderThickness="1"
                                            ToolTip="{Binding BenchmarkTooltip}">
                                        <TextBlock Text="{Binding ScoreDisplay}"
                                                   Foreground="#D2A8FF"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <!-- CursorBench 4.0 Correctness Score -->
                                    <Border Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Background="#1F56D4DD"
                                            BorderBrush="#5556D4DD"
                                            BorderThickness="1"
                                            ToolTip="{Binding CursorBenchTooltip}">
                                        <TextBlock Text="{Binding CursorBenchScoreDisplay}"
                                                   Foreground="#56D4DD"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <!-- Standard Mode Input / Output $/1M -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding StandardInOutDisplay}"
                                               ToolTip="{Binding StandardPricingTooltip}"
                                               Foreground="#E6EDF3"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Fast / Priority Mode Input / Output $/1M -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding FastInOutDisplay}"
                                               ToolTip="{Binding FastPricingTooltip}"
                                               Foreground="#FFA657"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Cached Input $/1M -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding CachedPriceDisplay}"
                                               ToolTip="{Binding CachedPricingTooltip}"
                                               Foreground="#79C0FF"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Context Window -->
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding ContextDisplay}"
                                               Foreground="#8B949E"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Estimated Task Cost -->
                                    <TextBlock Grid.Column="7"
                                               Text="{Binding EstimatedTaskCostDisplay}"
                                               Foreground="#3FB950"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />

                                    <!-- Hide / Unhide & Remove Row Actions -->
                                    <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="DEL"
                                                Tag="{Binding Id}"
                                                Click="RowRemoveButton_Click"
                                                Visibility="{Binding IsUserAdded, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,4,0"
                                                Padding="4,2"
                                                FontSize="8.5"
                                                FontWeight="SemiBold"
                                                Foreground="#F85149"
                                                Background="#161B22"
                                                BorderBrush="#30363D"
                                                Cursor="Hand"
                                                ToolTip="Remove this user-added OpenRouter model" />
                                        <Button Content="{Binding HideActionLabel}"
                                                Tag="{Binding Id}"
                                                Click="RowHideButton_Click"
                                                Padding="5,2"
                                                FontSize="9"
                                                FontWeight="SemiBold"
                                                Foreground="#8B949E"
                                                Background="#161B22"
                                                BorderBrush="#30363D"
                                                Cursor="Hand"
                                                ToolTip="{Binding HideActionTooltip}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- PW-12: Non-modal First-Run Onboarding Banner (Row 3 top) -->
            <Border x:Name="FirstRunBanner"
                    Grid.Row="3"
                    VerticalAlignment="Top"
                    Margin="10,6,10,0"
                    Padding="10,8"
                    CornerRadius="6"
                    Background="#F0161B22"
                    BorderBrush="#58A6FF"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Welcome to AI PriceWatch — Quick Guide"
                                   Foreground="#58A6FF"
                                   FontWeight="Bold"
                                   FontSize="11" />
                        <TextBlock Text="• Press Ctrl+Shift+Space anytime to show/hide this HUD. Closing (✕) hides it to the system tray."
                                   Foreground="#C9D1D9"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="• Works offline with the bundled catalog. Click SYNC LIVE for OpenRouter rates &amp; CursorBench scores; N/A means no verified Fast/Benchmark data."
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="Settings"
                                Click="SettingsButton_Click"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                FontSize="10"
                                Foreground="#E6EDF3"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Open Settings from Quick Guide" />
                        <Button Content="Got it"
                                Click="DismissOnboardingButton_Click"
                                Padding="8,3"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#F0F6FC"
                                Background="#1F6FEB"
                                BorderBrush="#58A6FF"
                                Cursor="Hand"
                                AutomationProperties.Name="Dismiss Quick Guide" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PW-13: Empty Filter State (Row 3 center) -->
            <StackPanel x:Name="EmptyStatePanel"
                        Grid.Row="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="No models match the current filters."
                           Foreground="#C9D1D9"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Try clearing the search box, switching provider to All, or unhiding models."
                           Foreground="#8B949E"
                           FontSize="11"
                           Margin="0,4,0,10"
                           HorizontalAlignment="Center" />
                <Button Content="Reset Filters"
                        Click="ResetFiltersButton_Click"
                        Padding="12,5"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#F0F6FC"
                        Background="#1F6FEB"
                        BorderBrush="#58A6FF"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Reset all filters" />
            </StackPanel>

            <!-- PW-12: Compact Settings & Help Drawer -->
            <Border x:Name="SettingsPanel"
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    Margin="16,8,16,8"
                    Padding="14"
                    CornerRadius="8"
                    Background="#F5161B22"
                    BorderBrush="#4458A6FF"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SETTINGS &amp; HELP"
                                           Foreground="#58A6FF"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsVersionText"
                                           Text="v0.0.0"
                                           Foreground="#8B949E"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="8,1,0,0"
                                           AutomationProperties.Name="Application version" />
                            </StackPanel>
                            <Button Content="Close (Esc)"
                                    Click="CloseSettingsButton_Click"
                                    HorizontalAlignment="Right"
                                    Padding="8,3"
                                    FontSize="10"
                                    Foreground="#E6EDF3"
                                    Background="#1F242C"
                                    BorderBrush="#30363D"
                                    Cursor="Hand"
                                    AutomationProperties.Name="Close Settings" />
                        </Grid>

                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="Start with Windows (disabled by default)"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed"
                                  Foreground="#E6EDF3"
                                  FontSize="11"
                                  Margin="0,0,0,6"
                                  AutomationProperties.Name="Start with Windows" />
                        <TextBlock x:Name="StartupNoteText"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="20,0,0,8"
                                   Visibility="Collapsed" />

                        <CheckBox Content="Always on Top (Pin HUD)"
                                  IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}"
                                  Foreground="#E6EDF3"
                                  FontSize="11"
                                  Margin="0,0,0,6"
                                  AutomationProperties.Name="Always on Top" />

                        <CheckBox Content="Fast / Priority Mode pricing (shows N/A when unverified)"
                                  IsChecked="{Binding IsFastMode, Mode=TwoWay}"
                                  Foreground="#E6EDF3"
                                  FontSize="11"
                                  Margin="0,0,0,10"
                                  AutomationProperties.Name="Fast or Priority Mode" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Show Quick Guide"
                                    Click="ShowOnboardingButton_Click"
                                    Padding="9,4"
                                    Margin="0,0,8,0"
                                    FontSize="10"
                                    Foreground="#E6EDF3"
                                    Background="#1F242C"
                                    BorderBrush="#30363D"
                                    Cursor="Hand"
                                    AutomationProperties.Name="Show First-Run Quick Guide" />
                            <Button x:Name="SettingsCheckUpdateButton"
                                    Content="Check for Updates"
                                    Click="SettingsCheckUpdateButton_Click"
                                    Padding="9,4"
                                    FontSize="10"
                                    Foreground="#58A6FF"
                                    Background="#1F242C"
                                    BorderBrush="#30363D"
                                    Cursor="Hand"
                                    AutomationProperties.Name="Check for application updates" />
                        </StackPanel>

                        <TextBlock Text="KEYBOARD SHORTCUTS"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="• Ctrl+Shift+Space: Global Show / Hide HUD&#x0a;• Ctrl+F: Focus Search&#x0a;• Ctrl+M: Toggle Fast Mode&#x0a;• Alt+1..7: Switch Provider Tabs&#x0a;• Esc: Close Settings or Clear Search"
                                   Foreground="#C9D1D9"
                                   FontSize="10"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="PRICING PROVENANCE &amp; OFFLINE BEHAVIOR"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Bundled rates include source &amp; verification date (hover any row or price). SYNC LIVE fetches OpenRouter standard rates only and never manufactures Fast/Priority multipliers. Unsupported rates display N/A and are excluded from lowest-cost comparisons."
                                   Foreground="#C9D1D9"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Add Models from OpenRouter Drawer -->
            <Border x:Name="AddModelsOverlay"
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    Margin="16,8,16,8"
                    Padding="14"
                    CornerRadius="8"
                    Background="#F5161B22"
                    BorderBrush="#4458A6FF"
                    BorderThickness="1"
                    Visibility="{Binding IsAddModelsOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ADD MODELS FROM OPENROUTER"
                                       Foreground="#58A6FF"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Border Background="#223FB950"
                                    BorderBrush="#3FB950"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasNewOpenRouterModels, Converter={StaticResource BoolToVis}}">
                                <TextBlock Foreground="#3FB950" FontSize="9" FontWeight="Bold">
                                    <Run Text="{Binding NewOpenRouterCount, Mode=OneWay}" />
                                    <Run Text=" NEW SINCE LAST SYNC" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <Button Content="Close (Esc)"
                                Click="CloseAddModelsButton_Click"
                                HorizontalAlignment="Right"
                                Padding="8,3"
                                FontSize="10"
                                Foreground="#C9D1D9"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Close Add Models" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding AddModelsSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0D1117"
                                 Foreground="#E6EDF3"
                                 BorderBrush="#30363D"
                                 FontSize="11"
                                 Padding="8,5"
                                 Margin="0,0,10,0"
                                 AutomationProperties.Name="Search OpenRouter models" />
                        <CheckBox Grid.Column="1"
                                  Content="New since last sync"
                                  IsChecked="{Binding OnlyNewCandidates, Mode=TwoWay}"
                                  Foreground="#C9D1D9"
                                  FontSize="11"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Click SYNC LIVE in the top bar first to load the OpenRouter model feed."
                                       Foreground="#8B949E"
                                       FontSize="11"
                                       Margin="0,12,0,12"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvailableCandidates.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding AvailableCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121720"
                                                BorderBrush="#21262D"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="10,7"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="#E6EDF3"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold" />
                                                        <Border Background="#223FB950"
                                                                BorderBrush="#3FB950"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                Padding="4,0"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="NEW"
                                                                       Foreground="#3FB950"
                                                                       FontSize="8.5"
                                                                       FontWeight="Bold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Foreground="#7D8590" FontSize="9.5">
                                                        <Run Text="{Binding Provider, Mode=OneWay}" />
                                                        <Run Text=" • " />
                                                        <Run Text="{Binding FullId, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding InOutDisplay}"
                                                           Foreground="#C9D1D9"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"
                                                           Margin="0,0,10,0" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ContextDisplay}"
                                                           Foreground="#8B949E"
                                                           FontSize="10.5"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"
                                                           Margin="0,0,10,0" />

                                                <Button Grid.Column="3"
                                                        Content="{Binding ActionLabel}"
                                                        Tag="{Binding FullId}"
                                                        IsEnabled="{Binding CanAdd}"
                                                        Click="CandidateActionButton_Click"
                                                        Padding="8,3"
                                                        FontSize="9.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="#58A6FF"
                                                        Background="#1F242C"
                                                        BorderBrush="#30363D"
                                                        Cursor="Hand" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Row 4: Interactive Task Cost Estimator & Status Bar -->
            <Border Grid.Row="4"
                    Background="#33161B22"
                    BorderBrush="#2630363D"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="12,7,14,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="WORKLOAD:"
                                   Foreground="#8B949E"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox x:Name="PresetComboBox"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="148"
                                  FontSize="11"
                                  Margin="0,0,10,0"
                                  ToolTip="Select a typical task token workload to compare model costs" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="IN:" Foreground="#8B949E" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="56"
                                 Text="{Binding TaskInputTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#161B22"
                                 Foreground="#E6EDF3"
                                 BorderBrush="#30363D"
                                 FontSize="11"
                                 Padding="4,1"
                                 Margin="0,0,8,0" />

                        <TextBlock Text="CACHE:" Foreground="#79C0FF" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="56"
                                 Text="{Binding TaskCachedTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#161B22"
                                 Foreground="#79C0FF"
                                 BorderBrush="#30363D"
                                 FontSize="11"
                                 Padding="4,1"
                                 Margin="0,0,8,0" />

                        <TextBlock Text="OUT:" Foreground="#FFA657" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="52"
                                 Text="{Binding TaskOutputTokens, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#161B22"
                                 Foreground="#FFA657"
                                 BorderBrush="#30363D"
                                 FontSize="11"
                                 Padding="4,1" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="ClearDiffsButton"
                                Content="Clear diffs"
                                Click="ClearDiffsButton_Click"
                                Visibility="{Binding HasPriceDiffs, Converter={StaticResource BoolToVis}}"
                                Padding="6,1"
                                Margin="0,0,8,0"
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="#8B949E"
                                Background="#1F242C"
                                BorderBrush="#30363D"
                                Cursor="Hand"
                                AutomationProperties.Name="Clear price diff badges"
                                ToolTip="Clear active price change badges" />
                        <Button x:Name="RetrySyncButton"
                                Content="Retry Sync"
                                Click="SyncButton_Click"
                                Visibility="{Binding CanRetrySync, Converter={StaticResource BoolToVis}}"
                                Padding="6,1"
                                Margin="0,0,8,0"
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="#F85149"
                                Background="#22F85149"
                                BorderBrush="#F85149"
                                Cursor="Hand"
                                AutomationProperties.Name="Retry live price sync"
                                ToolTip="Retry fetching live prices from OpenRouter" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#7D8590"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
